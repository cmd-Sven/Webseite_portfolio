# Supabase (Project Settings → API) — Client / Vite
# Nur Platzhalter — echte Werte nur in .env.local (nie committen).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Admin-ATS: E-Mail muss als User in Supabase Auth existieren.
# Passwörter / Tokens nie hier oder in Git ablegen.
VITE_ADMIN_EMAIL=admin@example.com

# Monitor-Zugang: Rolle app_metadata.role = monitor
VITE_MONITOR_EMAIL=monitor@example.com

# Nur lokal (Dev): optionale One-Click-Hilfen im UI.
# Niemals in Production / Vercel setzen — nur in .env.local, nie committen.
VITE_ADMIN_DEV_PASSWORD=
VITE_MONITOR_DEV_PASSWORD=

# ---------------------------------------------------------------------------
# E-Mail-Versand: aktuell mailto: (lokaler Mail-Client).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Edge Function Secrets (NICHT mit VITE_ prefixen — nie im Browser!)
# Setzen via Dashboard → Edge Functions → Secrets
# oder: supabase secrets set KEY=... (Werte nie in Git)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Vercel Serverless (`/api/generate-pdf`, `/api/resume`)
# In Vercel Project Settings als Env Vars setzen — nicht in dieses File.
# Lokal: `vercel dev` (nicht nur `vite`) — API-Routen brauchen das.
# ---------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=
# PUPPETEER_EXECUTABLE_PATH=
