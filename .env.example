# Supabase (Project Settings → API) — Client / Vite
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Nur diese E-Mail darf das Admin-ATS nutzen (muss als User in Supabase Auth existieren).
# Passwort nie hier oder in Git ablegen — nur in Supabase Auth setzen.
VITE_ADMIN_EMAIL=admin@example.com

# Nur lokal (Dev): optional für One-Click-Login im Admin-UI.
# Niemals in Production / Vercel setzen — nur in .env.local.
VITE_ADMIN_DEV_PASSWORD=

# ---------------------------------------------------------------------------
# E-Mail-Versand: aktuell mailto: (lokaler Mail-Client). Kein Resend/SMTP.
# PDFs manuell anhängen. Später optional RESEND_API_KEY — keine Fake-Server.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Edge Function Secrets (NICHT mit VITE_ prefixen — nie im Browser!)
# Setzen via Dashboard → Edge Functions → Secrets
# oder: supabase secrets set OPENAI_API_KEY=sk-... OPENAI_MODEL=gpt-4o-mini
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# SUPABASE_URL und SUPABASE_ANON_KEY werden in Edge Functions automatisch
# bereitgestellt — nicht manuell als VITE_-Vars für den Server setzen.

# ---------------------------------------------------------------------------
# Vercel Serverless `/api/generate-pdf` (Puppeteer + @sparticuz/chromium)
# In Vercel Project Settings dieselben Werte als Env Vars setzen.
# Lokal: `vercel dev` (nicht nur `vite`) — PDF braucht die API-Route.
# Optional lokal: PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/...
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
# ADMIN_EMAIL=admin@example.com
# PUPPETEER_EXECUTABLE_PATH=
